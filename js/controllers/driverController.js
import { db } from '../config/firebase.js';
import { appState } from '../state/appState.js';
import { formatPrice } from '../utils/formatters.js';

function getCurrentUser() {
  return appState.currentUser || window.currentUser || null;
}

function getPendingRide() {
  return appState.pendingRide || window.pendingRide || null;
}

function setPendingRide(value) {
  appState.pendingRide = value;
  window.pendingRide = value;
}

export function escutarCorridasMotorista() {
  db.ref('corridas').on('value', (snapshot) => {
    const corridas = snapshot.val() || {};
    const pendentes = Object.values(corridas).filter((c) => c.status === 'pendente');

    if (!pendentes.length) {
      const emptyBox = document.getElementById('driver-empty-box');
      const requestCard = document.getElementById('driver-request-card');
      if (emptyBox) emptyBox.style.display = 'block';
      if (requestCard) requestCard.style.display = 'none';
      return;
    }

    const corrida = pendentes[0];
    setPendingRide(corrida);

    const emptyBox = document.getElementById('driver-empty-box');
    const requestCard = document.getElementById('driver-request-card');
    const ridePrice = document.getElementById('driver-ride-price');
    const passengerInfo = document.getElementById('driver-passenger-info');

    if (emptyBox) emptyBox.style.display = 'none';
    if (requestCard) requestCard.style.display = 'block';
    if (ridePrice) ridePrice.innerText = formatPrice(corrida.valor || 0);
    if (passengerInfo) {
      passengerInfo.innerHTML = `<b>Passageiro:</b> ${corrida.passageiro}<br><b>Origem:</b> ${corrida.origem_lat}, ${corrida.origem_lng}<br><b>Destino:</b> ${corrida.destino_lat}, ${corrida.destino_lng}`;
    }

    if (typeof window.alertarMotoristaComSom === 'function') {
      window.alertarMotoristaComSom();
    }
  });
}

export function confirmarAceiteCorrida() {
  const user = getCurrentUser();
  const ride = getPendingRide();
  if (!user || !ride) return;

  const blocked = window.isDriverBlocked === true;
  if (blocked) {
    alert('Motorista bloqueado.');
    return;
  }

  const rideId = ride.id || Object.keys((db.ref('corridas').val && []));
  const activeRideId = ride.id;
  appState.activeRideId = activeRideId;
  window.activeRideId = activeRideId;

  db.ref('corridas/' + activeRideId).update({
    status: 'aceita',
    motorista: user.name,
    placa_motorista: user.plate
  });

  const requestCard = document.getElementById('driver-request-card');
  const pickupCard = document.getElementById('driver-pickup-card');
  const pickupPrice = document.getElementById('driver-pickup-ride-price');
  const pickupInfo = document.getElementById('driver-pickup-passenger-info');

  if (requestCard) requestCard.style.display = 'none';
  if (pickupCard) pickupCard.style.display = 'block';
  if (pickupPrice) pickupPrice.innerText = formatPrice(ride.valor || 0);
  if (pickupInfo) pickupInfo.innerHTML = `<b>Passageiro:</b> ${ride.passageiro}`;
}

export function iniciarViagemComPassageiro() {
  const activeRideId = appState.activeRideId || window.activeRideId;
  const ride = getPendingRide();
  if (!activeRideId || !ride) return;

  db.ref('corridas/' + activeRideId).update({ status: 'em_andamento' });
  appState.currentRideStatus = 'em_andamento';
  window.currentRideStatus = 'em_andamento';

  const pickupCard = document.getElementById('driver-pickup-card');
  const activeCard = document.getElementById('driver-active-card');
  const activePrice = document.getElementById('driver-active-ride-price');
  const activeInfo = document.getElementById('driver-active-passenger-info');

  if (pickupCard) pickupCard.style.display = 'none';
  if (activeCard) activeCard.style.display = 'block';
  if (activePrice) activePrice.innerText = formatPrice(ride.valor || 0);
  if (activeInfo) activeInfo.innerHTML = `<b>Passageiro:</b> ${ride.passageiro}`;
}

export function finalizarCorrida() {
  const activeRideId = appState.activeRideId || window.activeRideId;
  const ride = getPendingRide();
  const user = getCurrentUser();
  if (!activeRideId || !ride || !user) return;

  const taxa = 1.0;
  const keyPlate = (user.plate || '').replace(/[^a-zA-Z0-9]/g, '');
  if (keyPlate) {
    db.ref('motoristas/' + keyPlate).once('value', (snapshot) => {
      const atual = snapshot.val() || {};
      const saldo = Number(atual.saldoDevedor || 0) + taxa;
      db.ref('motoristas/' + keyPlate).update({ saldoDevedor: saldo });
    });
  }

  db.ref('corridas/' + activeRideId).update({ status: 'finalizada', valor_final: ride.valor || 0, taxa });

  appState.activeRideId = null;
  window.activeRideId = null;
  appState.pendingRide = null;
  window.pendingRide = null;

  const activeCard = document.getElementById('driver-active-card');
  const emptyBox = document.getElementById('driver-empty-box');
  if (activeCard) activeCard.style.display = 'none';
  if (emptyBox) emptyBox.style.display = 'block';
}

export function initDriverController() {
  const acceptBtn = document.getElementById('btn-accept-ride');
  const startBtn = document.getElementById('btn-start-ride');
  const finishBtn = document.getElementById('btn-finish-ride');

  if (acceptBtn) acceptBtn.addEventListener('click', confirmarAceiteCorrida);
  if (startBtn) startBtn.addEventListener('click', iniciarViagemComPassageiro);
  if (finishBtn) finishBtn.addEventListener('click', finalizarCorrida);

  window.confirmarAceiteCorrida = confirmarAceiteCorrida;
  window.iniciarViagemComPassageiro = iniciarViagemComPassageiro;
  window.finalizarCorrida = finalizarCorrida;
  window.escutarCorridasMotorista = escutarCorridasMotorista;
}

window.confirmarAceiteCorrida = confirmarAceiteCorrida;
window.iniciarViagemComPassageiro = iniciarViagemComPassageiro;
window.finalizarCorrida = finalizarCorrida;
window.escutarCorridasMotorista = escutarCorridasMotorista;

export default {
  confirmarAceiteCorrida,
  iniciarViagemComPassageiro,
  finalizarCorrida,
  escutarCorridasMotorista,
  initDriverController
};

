import { db } from '../config/firebase.js';
import { appState } from '../state/appState.js';
import { formatPrice } from '../utils/formatters.js';

const DEFAULT_LOCATION = [-21.5431, -43.0108];
const TAXA_MINIMA = 6.68;
const PRECO_POR_KM = 2.5;

function getCurrentUser() {
  return appState.currentUser || window.currentUser || null;
}

function getCurrentOrigin() {
  return window.origem || DEFAULT_LOCATION;
}

function getCurrentDestino() {
  return window.destino || null;
}

function setCurrentDestino(value) {
  window.destino = value;
}

function setCurrentValor(value) {
  window.valorEstimado = value;
}

function setCurrentDistancia(value) {
  window.distanciaKm = value;
}

export async function buscarEndereçoPorTexto(textoBusca) {
  const rawQuery = textoBusca || document.getElementById('destination-input')?.value?.trim();
  if (!rawQuery) return;

  let query = rawQuery;
  const lower = rawQuery.toLowerCase();
  if (!lower.includes('são joão nepomuceno') && !lower.includes('sjn')) {
    query = `${rawQuery}, São João Nepomuceno - MG`;
  }

  try {
    const viewbox = '-43.05,-21.50,-42.97,-21.58';
    const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&bounded=1&viewbox=${viewbox}&limit=1`;

    let response = await fetch(url);
    let data = await response.json();

    if (!data || data.length === 0) {
      const fallbackUrl = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=1`;
      response = await fetch(fallbackUrl);
      data = await response.json();
    }

    if (data && data.length > 0) {
      const lat = parseFloat(data[0].lat);
      const lng = parseFloat(data[0].lon);
      if (typeof window.onPassengerMapClick === 'function') {
        window.onPassengerMapClick({ latlng: { lat, lng } });
      }
    } else {
      alert('Endereço não encontrado em São João Nepomuceno. Tente indicar mais detalhes da rua ou ponto de referência.');
    }
  } catch (error) {
    console.error('Erro ao buscar endereço:', error);
    alert('Erro ao pesquisar o endereço.');
  }
}

export function iniciarReconhecimentoVoz() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) {
    alert('O seu navegador não suporta reconhecimento de voz. Por favor, digite o endereço.');
    return;
  }

  const recognition = new SpeechRecognition();
  recognition.lang = 'pt-BR';
  recognition.interimResults = false;

  const btnMic = document.getElementById('btn-voice');
  if (btnMic) btnMic.classList.add('listening');

  recognition.start();

  recognition.onresult = (event) => {
    if (btnMic) btnMic.classList.remove('listening');
    const transcript = event.results[0][0].transcript;
    const input = document.getElementById('destination-input');
    if (input) input.value = transcript;
    buscarEndereçoPorTexto(transcript);
  };

  recognition.onerror = () => {
    if (btnMic) btnMic.classList.remove('listening');
    alert('Não foi possível entender a voz. Tente falar novamente ou digite.');
  };

  recognition.onend = () => {
    if (btnMic) btnMic.classList.remove('listening');
  };
}

export function solicitarCorrida() {
  const user = getCurrentUser();
  const origem = getCurrentOrigin();
  const destino = getCurrentDestino();

  if (!user || !destino) {
    alert('Selecione um destino primeiro.');
    return;
  }

  const distancia = calcularDistancia(origem, destino);
  const valor = Math.max(TAXA_MINIMA, distancia * PRECO_POR_KM);

  setCurrentDistancia(distancia);
  setCurrentValor(valor);

  const rideRef = db.ref('corridas').push();
  const ride = {
    id: rideRef.key,
    passageiro: user.name,
    telefone: user.phone,
    origem_lat: origem[0],
    origem_lng: origem[1],
    destino_lat: destino[0],
    destino_lng: destino[1],
    valor,
    distancia_km: distancia,
    status: 'pendente',
    createdAt: Date.now()
  };

  rideRef.set(ride);
  appState.pendingRide = ride;

  const statusBox = document.getElementById('status-box');
  if (statusBox) {
    statusBox.innerText = 'Corrida solicitada. Aguardando motorista...';
    statusBox.style.display = 'block';
  }
}

export function atualizarDestinoSelecionado(latlng) {
  const destino = [latlng.lat, latlng.lng];
  setCurrentDestino(destino);

  if (window.pDestMarker && window.passengerMap) {
    window.passengerMap.removeLayer(window.pDestMarker);
  }

  const greenIcon = window.greenIcon || null;
  if (greenIcon && window.passengerMap) {
    window.pDestMarker = window.L.marker(destino, { icon: greenIcon }).addTo(window.passengerMap).bindPopup('Destino').bindTooltip('Destino', { permanent: true, direction: 'bottom', className: 'custom-label' });
  }

  const origem = getCurrentOrigin();
  const distancia = calcularDistancia(origem, destino);
  const valor = Math.max(TAXA_MINIMA, distancia * PRECO_POR_KM);

  setCurrentDistancia(distancia);
  setCurrentValor(valor);

  const distanceText = document.getElementById('distance-text');
  const priceText = document.getElementById('price-text');
  if (distanceText) distanceText.innerText = `Distância: ${distancia.toFixed(1)} km`;
  if (priceText) priceText.innerText = formatPrice(valor);

  const rideDetails = document.getElementById('ride-details');
  if (rideDetails) rideDetails.style.display = 'block';

  const statusBox = document.getElementById('status-box');
  if (statusBox) statusBox.style.display = 'none';
}

function calcularDistancia(a, b) {
  const toRad = (value) => (value * Math.PI) / 180;
  const R = 6371;
  const dLat = toRad(b[0] - a[0]);
  const dLng = toRad(b[1] - a[1]);
  const lat1 = toRad(a[0]);
  const lat2 = toRad(b[0]);
  const hav = Math.sin(dLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(hav));
}

export function initPassengerController() {
  const btnSearch = document.getElementById('btn-search-address');
  const btnRequest = document.getElementById('btn-request');
  const btnVoice = document.getElementById('btn-voice');

  if (btnSearch) {
    btnSearch.addEventListener('click', () => buscarEndereçoPorTexto(document.getElementById('destination-input')?.value || ''));
  }

  if (btnRequest) {
    btnRequest.addEventListener('click', solicitarCorrida);
  }

  if (btnVoice) {
    btnVoice.addEventListener('click', iniciarReconhecimentoVoz);
  }

  window.iniciarReconhecimentoVoz = iniciarReconhecimentoVoz;
  window.buscarEndereçoPorTexto = buscarEndereçoPorTexto;
  window.solicitarCorrida = solicitarCorrida;
  window.atualizarDestinoSelecionado = atualizarDestinoSelecionado;
}

window.iniciarReconhecimentoVoz = iniciarReconhecimentoVoz;
window.buscarEndereçoPorTexto = buscarEndereçoPorTexto;
window.solicitarCorrida = solicitarCorrida;
window.atualizarDestinoSelecionado = atualizarDestinoSelecionado;

export default {
  iniciarReconhecimentoVoz,
  buscarEndereçoPorTexto,
  solicitarCorrida,
  initPassengerController
};

